{
  "name": "logiq-erp",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:deps": "turbo run lint:deps",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run db:generate -w @erp/api",
    "db:migrate": "npm run db:migrate -w @erp/api",
    "stack:up": "docker compose -f packages/infra/docker-compose.yml up -d",
    "stack:down": "docker compose -f packages/infra/docker-compose.yml down"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
